+"""
+    select_matrix_knots(xs, flats, tol, mandatory, windows) -> Vector{Int}
+
+Indices of the ψ-grid knots the EL coefficient splines should keep, chosen by a removal-error
+test: an interior knot is dropped when the cubic Lagrange interpolant through its nearest kept
+neighbours (two per side) reproduces its value within `tol · max|M|` for **every element of every
+matrix** in `flats`. A cubic spline's third-derivative jumps at knots scale as (node error)/Δψ³,
+so knots that carry no information above the data's noise floor only roughen the integrand the
+Euler-Lagrange solver sees; this keeps knots exactly where the matrices have structure above `tol`.
+
+Passes repeat (never removing adjacent knots within one pass) until no knot is removable.
+Endpoints are always kept, as is any knot inside a rational-surface window: `mandatory[i] ± windows[i]`
+plus the nearest knot on each side, preserving the Δ′-stencil bracket structure the equilibrium
+grid encodes (see `GridRefinement.jl`). Residuals are normalized by each matrix's largest element
+so near-zero elements cannot noise-trap the test.
+"""
+function select_matrix_knots(xs::Vector{Float64}, flats::Vector{<:AbstractMatrix{ComplexF64}},
+    tol::Float64, mandatory::Vector{Float64}, windows::Vector{Float64})
+    n = length(xs)
+    tol <= 0 && return collect(1:n)
+
+    # Per-matrix absolute thresholds; every element of every matrix is tested against its own
+    # matrix's threshold, so no structure can hide in an unmonitored element.
+    thresholds = Float64[]
+    mats = AbstractMatrix{ComplexF64}[]
+    for flat in flats
+        scale = maximum(abs, flat; init=0.0)
+        scale == 0 && continue
+        push!(thresholds, tol * scale)
+        push!(mats, flat)
+    end
+    isempty(mats) && return collect(1:n)
+
+    protected = falses(n)
+    protected[1] = protected[n] = true
+    for (c, w) in zip(mandatory, windows)
+        lo = searchsortedlast(xs, c)
+        for i in (lo, lo + 1)                       # nearest knot on each side
+            1 <= i <= n && (protected[i] = true)
+        end
+        for i in searchsortedfirst(xs, c - w):searchsortedlast(xs, c + w)
+            1 <= i <= n && (protected[i] = true)
+        end
+    end
+
+    keep = trues(n)
+    changed = true
+    while changed
+        changed = false
+        kept = findall(keep)
+        removed_prev = false
+        for (pos, i) in pairs(kept)
+            (protected[i] || pos <= 2 || pos >= length(kept) - 1) && (removed_prev = false; continue)
+            if removed_prev                          # keep the test local: no adjacent removals per pass
+                removed_prev = false
+                continue
+            end
+            stencil = (kept[pos-2], kept[pos-1], kept[pos+1], kept[pos+2])
+            w = _lagrange4_weights(xs, stencil, xs[i])
+            removable = true
+            for (thr, flat) in zip(thresholds, mats)
+                if _max_stencil_residual(flat, stencil, w, i) > thr
+                    removable = false
+                    break
+                end
+            end
+            if removable
+                keep[i] = false
+                changed = true
+                removed_prev = true
+            end
+        end
+    end
+    return findall(keep)
+end
+
+# Cubic Lagrange weights at x for the four knot indices in `stencil`.
+function _lagrange4_weights(xs::Vector{Float64}, stencil::NTuple{4,Int}, x::Float64)
+    w = ntuple(a -> begin
+            wa = 1.0
+            for b in 1:4
+                a == b && continue
+                wa *= (x - xs[stencil[b]]) / (xs[stencil[a]] - xs[stencil[b]])
+            end
+            wa
+        end, 4)
+    return w
+end
+
+# Largest |interpolation residual| over every element of one flat matrix at row i.
+function _max_stencil_residual(flat::AbstractMatrix{ComplexF64}, stencil::NTuple{4,Int},
+    w::NTuple{4,Float64}, i::Int)
+    a, b, c, d = stencil
+    worst = 0.0
+    @inbounds for j in axes(flat, 2)
+        pred = w[1] * flat[a, j] + w[2] * flat[b, j] + w[3] * flat[c, j] + w[4] * flat[d, j]
+        r = abs(flat[i, j] - pred)
+        r > worst && (worst = r)
+    end
+    return worst
+end
+
